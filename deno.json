{
  "name": "@higher-order-testing/nocuous",
  "version": "1.1.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "publish": {
    "exclude": [
      ".github",
      ".rustfmt.toml",
      ".vscode",
      "Cargo.lock",
      "Cargo.toml",
      "rust-toolchain.toml",
      "test.ts",
      "src/fixtures"
    ]
  },
  "imports": {
    "@cliffy/ansi": "jsr:@cliffy/ansi@1.0.0-rc.7",
    "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.7",
    "@cliffy/table": "jsr:@cliffy/table@1.0.0-rc.7",
    "@denosaurs/wait": "jsr:@denosaurs/wait@^0.2.2",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": {
    "exclude": ["target", "lib"]
  },
  "lint": {
    "exclude": ["target", "lib"]
  },
  "lock": false,
  "tasks": {
    "build": "deno run -A jsr:@deno/wasmbuild@0.17.2",
    "cli": "deno run --allow-read --allow-net cli.ts",
    "test": "deno task test:rust && deno task test:deno",
    "test:deno": "deno test --allow-read=..",
    "test:rust": "cargo test"
  }
}
